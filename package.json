{
  "name": "91",
  "private": true,
  "license": "MIT",
  "version": "0.3.7",
  "type": "module",
  "engines": {
    "node": "^24.22.1",
    "npm": "^12.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "audit": "npm audit --audit-level=info",
    "lint": "tsc -p sdk/tsconfig.json --noEmit && tsc -p examples/custom-frontend/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run audit && npm run lint && npm test",
    "build": "npm run build:client",
    "verify": "npm run check && npm run build",
    "build:client": "tsc -p sdk/tsconfig.json",
    "dev:example": "vite --config examples/custom-frontend/vite.config.ts",
    "build:example": "tsc -p examples/custom-frontend/tsconfig.json && vite build --config examples/custom-frontend/vite.config.ts"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "npm@12.2.1"
}
